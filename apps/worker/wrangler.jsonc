{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tauro",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "directory": "public", "binding": "ASSETS" },
  "routes": [{ "pattern": "tauroagent.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "tauro", "database_id": "bdef5dff-6f7b-4fca-8f5d-d0b61ca9b8b5", "migrations_dir": "migrations" }],
  // Minute 1 of every hour: ingest the hour that just closed.
  "triggers": { "crons": ["1 * * * *"] },
  "vars": { "REGISTRY_ADDRESS": "0xfb88b3FaEd64ee8086008EC4acEb2243B005eE14" },
  // Read API limits per minute (src/apikeys.ts): open per IP, holder tiers per wallet key.
  "ratelimits": [
    { "name": "RL_OPEN", "namespace_id": "4663001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_HOLDER", "namespace_id": "4663002", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RL_HOLDER_PLUS", "namespace_id": "4663003", "simple": { "limit": 6000, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
