{
  "name": "@tauro/worker",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:client && wrangler deploy --var GIT_SHA:$(git rev-parse HEAD)",
    "db:migrate:local": "wrangler d1 migrations apply tauro --local",
    "db:migrate:remote": "wrangler d1 migrations apply tauro --remote",
    "build:client": "esbuild src/client/verify.ts src/client/studio.ts --bundle --format=esm --minify --target=es2022 --outdir=public/js"
  },
  "dependencies": {
    "viem": "^2.38.0",
    "@tauro/seal": "*",
    "@tauro/engine": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "wrangler": "^4.45.0"
  }
}
