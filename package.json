{
  "name": "tauro",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "contracts",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/worker && tsc -p apps/worker/tsconfig.client.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "check:claims": "node tools/claimcheck.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
